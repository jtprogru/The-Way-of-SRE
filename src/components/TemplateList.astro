---
/*
 * Перечень шаблонов на /templates/.
 *
 * Состав, порядок и связь с листьями — src/data/templates.ts. Имя шаблона
 * ведёт на файл в GitHub, а не на страницу сайта: шаблоны лежат в templates/
 * вне сборки, чтобы их можно было забрать сырым markdown. Листья — ссылки
 * внутрь сайта, имя и адрес берутся из карты.
 *
 * Что перечень совпадает с каталогом и с текстом листьев, проверяет
 * tools/data/check.ts.
 */
import { templateLeaves, templatePath, templateUrl, templates } from '../data/templates.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = templates.map((template) => ({ template, leaves: templateLeaves(template) }));
---

{items.length > 0 ? (
  <ul class="template-list not-content">
    {items.map(({ template, leaves }) => (
      <li id={template.id}>
        <p class="template-head">
          <a class="template-name" href={templateUrl(template)}>{template.label}</a>
          <code>{templatePath(template)}</code>
        </p>
        <p class="template-gist">{template.gist}</p>
        {leaves.length > 0 && (
          <p class="template-leaves">
            Разобран в {leaves.length === 1 ? 'листе' : 'листьях'}:{' '}
            {leaves.map((leaf, i) => (
              <>
                {i > 0 && ', '}
                <a href={`${base}${leaf.href}`}>{leaf.label}</a>
              </>
            ))}
          </p>
        )}
      </li>
    ))}
  </ul>
) : (
  <p class="template-list-empty">
    Шаблонов в каталоге пока нет. Они добавляются по одному, и каждый появится в этом перечне вместе
    со ссылками на листья.
  </p>
)}

<style>
  .template-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .template-list > li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 8px;
    background: var(--sl-color-bg-nav);
    /* Якорь #<id> не должен уезжать под липкую шапку. */
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
  }
  .template-list p {
    margin: 0;
  }
  /* not-content снимает со списка стили markdown, а с ними и цвет ссылок:
     без этого правила они браузерно-синие и выпадают из страницы. */
  .template-list a {
    color: var(--sl-color-text-accent);
  }
  .template-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .template-name {
    font-weight: 600;
  }
  .template-head code {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .template-leaves {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .template-list-empty {
    color: var(--sl-color-gray-3);
  }
</style>
