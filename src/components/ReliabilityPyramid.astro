---
// ReliabilityPyramid.astro — иерархия надёжности сервиса (Dickerson).
// Используется на /priorities/ как третья ось: не «обязательно ли для роли»
// (priority) и не «на каком уровне зрелости» (SFIA), а «в каком порядке
// практики вообще строятся».
//
// Архитектура: DOM-стек ступеней, без SVG. Starlight не поддерживает mermaid,
// а рисовать трапеции в SVG ради семи подписей — лишняя сложность: ступени
// сужаются к вершине через width, форма пирамиды читается и без наклонных
// граней. На узких экранах сужение отключается, чтобы подписи не ломались.
//
// Данные — src/data/reliabilityHierarchy.ts (единственный источник правды).

import { reliabilityHierarchy } from '../data/reliabilityHierarchy.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;

// Рисуем сверху вниз: вершина (Product) первой, фундамент (Monitoring) последним.
const layers = [...reliabilityHierarchy].sort((a, b) => b.level - a.level);
const maxLevel = layers.length;

// Ширина ступени: фундамент — 100%, вершина — 58%. Шаг равномерный.
const MIN_W = 58;
const widthFor = (level: number) => MIN_W + ((maxLevel - level) / (maxLevel - 1)) * (100 - MIN_W);

// Насыщенность заливки: чем ниже слой, тем плотнее — фундамент визуально «тяжелее».
const tintFor = (level: number) => 0.06 + ((maxLevel - level) / (maxLevel - 1)) * 0.14;
---

<figure class="pyramid not-content">
  <ol class="pyramid-stack">
    {layers.map((layer) => (
      <li
        class="pyramid-layer"
        id={`hierarchy-${layer.id}`}
        style={`--w: ${widthFor(layer.level).toFixed(1)}%; --tint: ${(1 - tintFor(layer.level)).toFixed(2)}`}
      >
        <div class="pyramid-head">
          <span class="pyramid-level" aria-hidden="true">{layer.level}</span>
          <span class="pyramid-label">{layer.label}</span>
        </div>
        <p class="pyramid-gist">{layer.gist}</p>
        <ul class="pyramid-leaves">
          {layer.leaves.map((leaf) => (
            <li>
              <a class="pyramid-leaf" href={link(leaf.href)}>{leaf.label}</a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  <figcaption class="pyramid-caption">
    Снизу вверх: каждый слой опирается на нижние. Номер — уровень иерархии, не приоритет и не SFIA.
  </figcaption>
</figure>

<style>
  .pyramid {
    margin: 1.5rem 0 2rem;
  }

  .pyramid-stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .pyramid-layer {
    width: var(--w);
    box-sizing: border-box;
    padding: 0.7rem 1rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    /* Fallback для браузеров без color-mix — ровная лёгкая подложка. */
    background: var(--sl-color-gray-7);
    background: color-mix(in srgb, var(--sl-color-gray-7) calc(var(--tint) * 100%), var(--sl-color-accent));
    transition: width 0.2s ease;
  }

  .pyramid-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .pyramid-level {
    flex: none;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
    padding: 0 0.35rem;
    background: var(--sl-color-bg);
  }

  .pyramid-label {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  .pyramid-gist {
    margin: 0.35rem 0 0.5rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }

  .pyramid-leaves {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pyramid-leaf {
    display: inline-block;
    font-size: 0.78rem;
    line-height: 1.2;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .pyramid-leaf:hover,
  .pyramid-leaf:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .pyramid-caption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  /*
   * На узком экране сужение к вершине только мешает: подписи переносятся
   * по-разному и форма всё равно не читается. Ступени становятся полосами.
   */
  @media (max-width: 800px) {
    .pyramid-layer {
      width: 100%;
    }
  }
</style>
