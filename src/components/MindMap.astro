---
// MindMap.astro — витринная карта всего дерева компетенций (#109).
//
// Что здесь есть и чего нет: компонент рисует и оживляет, состав узлов он
// не знает. Геометрия приходит из src/data/mindmap.ts, состав — из
// roadmap.ts через неё же. Добавленный лист появляется тут сам.
//
// Раскладка считается на билде: SVG со всеми узлами уезжает в HTML, без JS
// карта видна целиком (viewBox вписывает её в контейнер). Клиентский скрипт
// добавляет зум, панорамирование, фильтр приоритета и сворачивание — и
// пересчитывает Y тем же layoutY(), никакой второй реализации раскладки.
//
// Доступность: SVG помечен aria-hidden, ссылки внутри него убраны из
// таб-порядка, а полноценная навигация живёт в текстовом дереве под картой.
// Дублировать 94 узла в двух доступных для клавиатуры представлениях —
// значит заставить скринридер читать их дважды; список даёт то же
// содержимое в предсказуемой форме и работает без JS.

import {
  buildMindMap,
  edgePath,
  layoutY,
  viewBoxOf,
  NODE_H,
  ROOT_H,
  type MindMapNode,
} from '../data/mindmap.ts';
import { priorityLabels, type Priority } from '../data/roadmap.ts';
import { BRANCH_ICONS } from '../data/branchIcons.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;

// Иконки тулбара — те же 24×24 обводкой, что у ветвей в BRANCH_ICONS.
// Кнопки с двумя состояниями держат обе иконки в разметке, а переключает их
// CSS по aria-pressed: состояние и так живёт в атрибуте, дублировать его
// заменой узлов из скрипта незачем.
const TOOL_ICONS: Record<string, string[]> = {
  collapse: ['m7 20 5-5 5 5', 'm7 4 5 5 5-5'],
  expand: ['m7 15 5 5 5-5', 'm7 9 5-5 5 5'],
  filter: ['M22 3H2l8 9.46V19l4 2v-8.54Z'],
  zoomOut: ['M5 12h14'],
  zoomIn: ['M12 5v14', 'M5 12h14'],
  fit: [
    'M3 7V5a2 2 0 0 1 2-2h2',
    'M17 3h2a2 2 0 0 1 2 2v2',
    'M21 17v2a2 2 0 0 1-2 2h-2',
    'M7 21H5a2 2 0 0 1-2-2v-2',
    'M8 12h8',
  ],
  page: ['M15 3h6v6', 'M9 21H3v-6', 'M21 3l-7 7', 'M3 21l7-7'],
  pageBack: ['M4 14h6v6', 'M20 10h-6V4', 'M14 10l7-7', 'M3 21l7-7'],
  screen: ['M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z', 'M8 21h8'],
  screenBack: [
    'M8 3v3a2 2 0 0 1-2 2H3',
    'M21 8h-3a2 2 0 0 1-2-2V3',
    'M3 16h3a2 2 0 0 1 2 2v3',
    'M16 21v-3a2 2 0 0 1 2-2h3',
  ],
};

const graph = buildMindMap();
const initial = layoutY(graph);
const { y } = initial;
const byId = new Map(graph.nodes.map((n) => [n.id, n]));
const priorities = Object.keys(priorityLabels) as Priority[];

/** Половина высоты плашки: у корня она своя. */
const halfH = (node: MindMapNode) => (node.kind === 'root' ? ROOT_H : NODE_H) / 2;

/** Подпись ссылки для скринридера: приоритет читается словом, а не точкой. */
const nodeAria = (node: MindMapNode) =>
  node.priority ? `${node.label} — приоритет: ${priorityLabels[node.priority].ru}` : node.label;

/** Дерево для текстового фолбэка — тот же граф, обход по childIds. */
function subtree(id: string): MindMapNode[] {
  return byId.get(id)!.childIds.map((childId) => byId.get(childId)!);
}
const rootChildren = subtree(graph.rootId);
---

<figure class="mm not-content" data-priority-filter="off">
  <div class="mm-toolbar">
    <div class="mm-toolbar-group">
      <button
        type="button"
        class="mm-btn"
        data-mm="collapse-all"
        aria-pressed="false"
        aria-label="Свернуть до компетенций"
        title="Свернуть до компетенций"
      >
        <svg class="mm-icon mm-icon-off" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.collapse.map((d) => <path d={d} />)}
        </svg>
        <svg class="mm-icon mm-icon-on" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.expand.map((d) => <path d={d} />)}
        </svg>
      </button>
      <button
        type="button"
        class="mm-btn"
        data-mm="only-required"
        aria-pressed="false"
        aria-label="Показать только обязательное"
        title="Показать только обязательное"
      >
        <svg class="mm-icon" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.filter.map((d) => <path d={d} />)}
        </svg>
      </button>
    </div>
    <div class="mm-toolbar-group mm-zoom">
      <button type="button" class="mm-btn" data-mm="zoom-out" aria-label="Отдалить" title="Отдалить">
        <svg class="mm-icon" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.zoomOut.map((d) => <path d={d} />)}
        </svg>
      </button>
      <button
        type="button"
        class="mm-btn"
        data-mm="zoom-in"
        aria-label="Приблизить"
        title="Приблизить"
      >
        <svg class="mm-icon" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.zoomIn.map((d) => <path d={d} />)}
        </svg>
      </button>
      <button
        type="button"
        class="mm-btn"
        data-mm="fit"
        aria-label="Вписать карту в холст"
        title="Вписать карту в холст"
      >
        <svg class="mm-icon" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.fit.map((d) => <path d={d} />)}
        </svg>
      </button>
      <button
        type="button"
        class="mm-btn"
        data-mm="wide"
        aria-pressed="false"
        aria-label="Развернуть на всю страницу"
        title="Развернуть на всю страницу"
      >
        <svg class="mm-icon mm-icon-off" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.page.map((d) => <path d={d} />)}
        </svg>
        <svg class="mm-icon mm-icon-on" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.pageBack.map((d) => <path d={d} />)}
        </svg>
      </button>
      <button
        type="button"
        class="mm-btn"
        data-mm="fullscreen"
        aria-pressed="false"
        aria-label="Развернуть во весь экран"
        title="Развернуть во весь экран"
        hidden
      >
        <svg class="mm-icon mm-icon-off" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.screen.map((d) => <path d={d} />)}
        </svg>
        <svg class="mm-icon mm-icon-on" viewBox="0 0 24 24" aria-hidden="true">
          {TOOL_ICONS.screenBack.map((d) => <path d={d} />)}
        </svg>
      </button>
    </div>
  </div>

  <div class="mm-viewport" data-mm="viewport">
    <svg
      class="mm-svg"
      data-mm="svg"
      viewBox={viewBoxOf(graph, initial)}
      preserveAspectRatio="xMidYMid meet"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <g data-mm="canvas">
        <g class="mm-edges">
          {
            graph.edges.map((edge) => {
              const child = byId.get(edge.id)!;
              return (
                <path
                  class="mm-edge"
                  data-edge={edge.id}
                  data-branch={edge.branchId}
                  data-depth={child.depth}
                  data-priority={child.priority}
                  d={edgePath(edge.x1, y[edge.parentId], edge.x2, y[edge.id])}
                />
              );
            })
          }
        </g>

        {
          graph.nodes.map((node) => {
            const h = node.kind === 'root' ? ROOT_H : NODE_H;
            // Точка приоритета и иконка ветви стоят у грани, обращённой к
            // корню. Подпись остаётся по центру плашки: запас под кружки
            // заложен в поля плашки (NODE_PAD_X), а не в сдвиг текста —
            // сдвиг спасал бы от точки и толкал под кнопку сворачивания.
            const dotX = node.side === 'right' ? 13 : node.width - 13;
            const iconX = node.side === 'right' ? 11 : node.width - 27;
            const toggleX = node.side === 'right' ? node.width : 0;
            const icon = node.kind === 'branch' ? BRANCH_ICONS[node.branchId] : undefined;
            const hasKids = node.childIds.length > 0 && node.kind !== 'root';
            return (
              <g
                class="mm-node"
                data-id={node.id}
                data-kind={node.kind}
                data-branch={node.branchId}
                data-priority={node.priority}
                data-side={node.side}
                data-x={node.x}
                transform={`translate(${node.x} ${y[node.id]})`}
              >
                {node.href ? (
                  <a href={link(node.href)} tabindex="-1" aria-label={nodeAria(node)}>
                    <rect
                      x="0"
                      y={-halfH(node)}
                      width={node.width}
                      height={h}
                      rx="7"
                      ry="7"
                    />
                    {icon && (
                      <g class="mm-branch-icon" transform={`translate(${iconX} -8) scale(0.67)`}>
                        <path d={icon} />
                      </g>
                    )}
                    {node.priority && node.kind !== 'branch' && (
                      <circle class="mm-dot" cx={dotX} cy="0" r="4" />
                    )}
                    <text x={node.width / 2} y="4.5" text-anchor="middle">
                      {node.label}
                    </text>
                  </a>
                ) : (
                  <>
                    <rect x="0" y={-halfH(node)} width={node.width} height={h} rx="9" ry="9" />
                    <text x={node.width / 2} y="6" text-anchor="middle">
                      {node.label}
                    </text>
                  </>
                )}
                {hasKids && (
                  <g class="mm-toggle-btn" data-toggle={node.id} transform={`translate(${toggleX} 0)`}>
                    <circle r="8.5" />
                    <path class="mm-toggle-h" d="M -4 0 H 4" />
                    <path class="mm-toggle-v" d="M 0 -4 V 4" />
                  </g>
                )}
              </g>
            );
          })
        }
      </g>
    </svg>
  </div>

  <p class="mm-hint">
    Масштаб — кнопками, Ctrl (⌘) с колесом мыши или щипком. Перетаскивание двигает холст, кружок на
    краю плашки сворачивает ветку. Что делает кнопка тулбара — покажет подсказка при наведении.{' '}
    <span class="mm-hint-esc">Esc возвращает карту в текст.</span>
  </p>

  <ul class="mm-legend" aria-label="Легенда приоритетов">
    {
      priorities.map((p) => (
        <li>
          <span class="mm-legend-dot" data-priority={p} aria-hidden="true" />
          <span>{priorityLabels[p].ru}</span>
        </li>
      ))
    }
  </ul>

  <details class="mm-fallback">
    <summary>Всё дерево списком</summary>
    <ul>
      {
        rootChildren.map((branch) => (
          <li>
            <a href={link(branch.href!)}>{branch.label}</a>
            <ul>
              {subtree(branch.id).map((l1) => (
                <li>
                  <a href={link(l1.href!)}>{l1.label}</a>
                  <ul>
                    {subtree(l1.id).map((leaf) => (
                      <li>
                        <a href={link(leaf.href!)}>{leaf.label}</a>
                        {subtree(leaf.id).length > 0 && (
                          <ul>
                            {subtree(leaf.id).map((sub) => (
                              <li>
                                <a href={link(sub.href!)}>{sub.label}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </details>
</figure>

<script>
  import { buildMindMap, edgePath, layoutY, viewBoxOf } from '../data/mindmap.ts';

  const figure = document.querySelector<HTMLElement>('.mm');
  const viewport = figure?.querySelector<HTMLElement>('[data-mm="viewport"]');
  const svg = figure?.querySelector<SVGSVGElement>('[data-mm="svg"]');
  const canvas = figure?.querySelector<SVGGElement>('[data-mm="canvas"]');

  if (figure && viewport && svg && canvas) {
    // Тот же граф, что рендерил компонент: пересчёт раскладки при
    // сворачивании идёт по одной формуле с билдом.
    const graph = buildMindMap();
    const nodeEls = new Map<string, SVGGElement>();
    figure.querySelectorAll<SVGGElement>('.mm-node').forEach((el) => {
      nodeEls.set(el.dataset.id!, el);
    });
    const edgeEls = new Map<string, SVGPathElement>();
    figure.querySelectorAll<SVGPathElement>('.mm-edge').forEach((el) => {
      edgeEls.set(el.dataset.edge!, el);
    });

    const collapsed = new Set<string>();

    function render() {
      const layout = layoutY(graph, collapsed);
      const { y, visible } = layout;
      svg!.setAttribute('viewBox', viewBoxOf(graph, layout));

      nodeEls.forEach((el, id) => {
        if (!visible.has(id)) {
          el.style.display = 'none';
          return;
        }
        el.style.display = '';
        el.setAttribute('transform', `translate(${el.dataset.x} ${y[id]})`);
        el.dataset.collapsed = collapsed.has(id) ? 'true' : 'false';
      });

      for (const edge of graph.edges) {
        const el = edgeEls.get(edge.id);
        if (!el) continue;
        if (!visible.has(edge.id)) {
          el.style.display = 'none';
          continue;
        }
        el.style.display = '';
        el.setAttribute('d', edgePath(edge.x1, y[edge.parentId], edge.x2, y[edge.id]));
      }
    }

    // --- Сворачивание --------------------------------------------------
    svg.addEventListener('click', (event) => {
      const toggle = (event.target as Element).closest('.mm-toggle-btn');
      if (!toggle) return;
      event.preventDefault();
      const id = (toggle as SVGGElement).dataset.toggle!;
      if (collapsed.has(id)) collapsed.delete(id);
      else collapsed.add(id);
      render();
      syncCollapseAll();
    });

    const collapseAllBtn = figure.querySelector<HTMLButtonElement>('[data-mm="collapse-all"]');
    // «Свернуть до компетенций» = свернуть уровень L1: на холсте остаются
    // ветви и компетенции, листья прячутся. Это ровно то состояние, в
    // котором карта помещается на экран без зума.
    const l1Ids = graph.nodes.filter((n) => n.kind === 'l1').map((n) => n.id);

    // Подпись у кнопки одна — всплывающая. Тулбар иконочный, поэтому
    // состояние объясняют title и aria-label, а не текст внутри кнопки.
    function label(btn: HTMLButtonElement, pressed: boolean, text: string) {
      btn.setAttribute('aria-pressed', pressed ? 'true' : 'false');
      btn.title = text;
      btn.setAttribute('aria-label', text);
    }

    function syncCollapseAll() {
      if (!collapseAllBtn) return;
      const allCollapsed = l1Ids.every((id) => collapsed.has(id));
      label(
        collapseAllBtn,
        allCollapsed,
        allCollapsed ? 'Развернуть всё дерево' : 'Свернуть до компетенций',
      );
    }

    collapseAllBtn?.addEventListener('click', () => {
      const allCollapsed = l1Ids.every((id) => collapsed.has(id));
      if (allCollapsed) collapsed.clear();
      else l1Ids.forEach((id) => collapsed.add(id));
      render();
      syncCollapseAll();
      fit();
    });

    // --- Фильтр приоритета ---------------------------------------------
    const onlyRequired = figure.querySelector<HTMLButtonElement>('[data-mm="only-required"]');
    onlyRequired?.addEventListener('click', () => {
      const on = onlyRequired.getAttribute('aria-pressed') !== 'true';
      figure.dataset.priorityFilter = on ? 'on' : 'off';
      label(onlyRequired, on, on ? 'Показать все приоритеты' : 'Показать только обязательное');
    });

    // --- Зум и панорамирование -----------------------------------------
    // Координаты — в единицах viewBox: viewBox уже вписал карту в
    // контейнер, а трансформация холста работает поверх этой базы. Поэтому
    // «вписать в экран» — это просто сброс трансформации.
    const view = { x: 0, y: 0, k: 1 };
    const MIN_K = 0.5;
    const MAX_K = 8;

    function applyView() {
      canvas!.setAttribute('transform', `translate(${view.x} ${view.y}) scale(${view.k})`);
    }

    function toUser(clientX: number, clientY: number) {
      const ctm = svg!.getScreenCTM();
      if (!ctm) return { x: 0, y: 0 };
      const point = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
      return { x: point.x, y: point.y };
    }

    function zoomAt(clientX: number, clientY: number, factor: number) {
      const next = Math.min(MAX_K, Math.max(MIN_K, view.k * factor));
      if (next === view.k) return;
      const p = toUser(clientX, clientY);
      view.x = p.x - (p.x - view.x) * (next / view.k);
      view.y = p.y - (p.y - view.y) * (next / view.k);
      view.k = next;
      applyView();
    }

    function zoomCenter(factor: number) {
      const rect = viewport!.getBoundingClientRect();
      zoomAt(rect.left + rect.width / 2, rect.top + rect.height / 2, factor);
    }

    function fit() {
      view.x = 0;
      view.y = 0;
      view.k = 1;
      applyView();
    }

    figure.querySelector('[data-mm="zoom-in"]')?.addEventListener('click', () => zoomCenter(1.25));
    figure.querySelector('[data-mm="zoom-out"]')?.addEventListener('click', () => zoomCenter(0.8));
    figure.querySelector('[data-mm="fit"]')?.addEventListener('click', fit);

    // --- Разворот: на всю страницу и во весь экран ------------------------
    // Два режима, одна раскладка. «На всю страницу» — оверлей поверх
    // документа: карта занимает вьюпорт, вкладки и адресная строка остаются.
    // «Во весь экран» — тот же оверлей, но через Fullscreen API, без хрома
    // браузера. Оба состояния сводятся к одному атрибуту data-expanded:
    // стили не должны знать, каким путём карта развернулась, а завязываться
    // на :fullscreen нельзя — в старых Safari незнакомый селектор в группе
    // убивает всё правило целиком.
    const wideBtn = figure.querySelector<HTMLButtonElement>('[data-mm="wide"]');
    const fsBtn = figure.querySelector<HTMLButtonElement>('[data-mm="fullscreen"]');
    const fsApi = {
      request: figure.requestFullscreen?.bind(figure),
      exit: document.exitFullscreen?.bind(document),
    };
    let wide = false;
    // Место, куда карта вернётся из оверлея.
    //
    // На время разворота figure переезжает в <body>. Иначе никакого «поверх
    // страницы» не выходит: Starlight ставит .main-pane isolation: isolate, а
    // это отдельный контекст наложения — любой z-index внутри него остаётся
    // под шапкой и сайдбаром. Переезд надёжнее, чем прятать чужие панели по
    // их классам: те могут поменяться с версией темы.
    //
    // Полный экран переезда не требует (top layer и так рисуется поверх
    // всего), и напрашиваться на него не стоит: перемещение узла в DOM
    // браузер вправе счесть поводом выйти из полноэкранного режима.
    const anchor = document.createComment('mind map');
    let scrollY = 0;

    const isFullscreen = () => document.fullscreenElement === figure;

    function syncExpanded() {
      const expanded = wide || isFullscreen();
      figure!.dataset.expanded = expanded ? 'true' : 'false';
      // Скролл страницы гасим только под оверлеем: в нативном полном экране
      // документ и так не виден, а лишний lock пришлось бы снимать по
      // событию выхода, которое браузер шлёт не всегда предсказуемо.
      document.documentElement.classList.toggle('mm-locked', wide && !isFullscreen());
      if (wideBtn) {
        label(wideBtn, wide, wide ? 'Вернуть карту в текст' : 'Развернуть на всю страницу');
      }
      if (fsBtn) {
        const fs = isFullscreen();
        label(fsBtn, fs, fs ? 'Выйти из полноэкранного режима' : 'Развернуть во весь экран');
      }
      // Размер холста поменялся — сбрасываем зум, иначе карта остаётся
      // сдвинутой относительно нового вьюпорта. viewBox вписывает её сам.
      requestAnimationFrame(fit);
    }

    function setWide(next: boolean) {
      if (next === wide) return;
      if (next) {
        scrollY = window.scrollY;
        figure!.before(anchor);
        document.body.appendChild(figure!);
      } else {
        anchor.replaceWith(figure!);
      }
      wide = next;
      syncExpanded();
      // Возврат карты в поток документа сдвигает страницу — ставим её туда,
      // где читатель был до разворота.
      if (!next) window.scrollTo({ top: scrollY });
    }

    wideBtn?.addEventListener('click', () => setWide(!wide));

    if (fsBtn && fsApi.request && document.fullscreenEnabled) {
      fsBtn.hidden = false;
      fsBtn.addEventListener('click', async () => {
        try {
          if (isFullscreen()) await fsApi.exit?.();
          else await fsApi.request!();
        } catch {
          // Отказ (iframe без allow="fullscreen", политика браузера) не
          // должен оставлять пользователя ни с чем: разворачиваем оверлеем.
          setWide(true);
        }
      });
    }

    document.addEventListener('fullscreenchange', syncExpanded);

    // Esc выходит из оверлея. В нативном полном экране его перехватывает
    // браузер, до нас событие не доходит — и не нужно.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !wide || isFullscreen()) return;
      setWide(false);
    });

    // Зум по Ctrl/⌘ + колесо. Просто колесо оставляем странице: карта
    // занимает почти весь экран, и перехват прокрутки превращал бы её в
    // ловушку — прокрутить страницу мимо карты было бы нечем.
    viewport.addEventListener(
      'wheel',
      (event) => {
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        zoomAt(event.clientX, event.clientY, event.deltaY < 0 ? 1.12 : 1 / 1.12);
      },
      { passive: false },
    );

    // Указатели: один — панорамирование, два — щипок. Одна и та же
    // механика на мыши и на тач-экране, отдельного мобильного режима нет.
    //
    // Два правила, без которых ссылки на узлах перестают открываться.
    //
    // Первое: захват указателя ставится не на pointerdown, а только когда
    // перетаскивание действительно началось. При активном захвате Chrome
    // переадресует на элемент-захватчик и совместимостные mouse-события,
    // включая click, — то есть до <a> внутри SVG клик не доходит вовсе.
    //
    // Второе: порог перетаскивания считается в пикселях экрана, а не в
    // единицах viewBox. В раскрытом состоянии карта вписана с масштабом
    // около 0.3, один экранный пиксель — это больше двух единиц холста, и
    // порог в единицах принимал любое дрожание руки за перетаскивание.
    const DRAG_THRESHOLD_PX = 4;
    const pointers = new Map<number, { x: number; y: number }>();
    let origin: { x: number; y: number } | null = null;
    let dragging = false;
    let pinchDist = 0;

    viewport.addEventListener('pointerdown', (event) => {
      if ((event.target as Element).closest('.mm-toggle-btn')) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 1) {
        origin = { x: event.clientX, y: event.clientY };
        dragging = false;
      }
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
        dragging = true;
      }
    });

    function startDragging(event: PointerEvent) {
      dragging = true;
      // Захват нужен, чтобы перетаскивание не обрывалось при выходе курсора
      // за пределы карты. На чужом указателе (мышь отпущена вне окна) вызов
      // бросает — тогда просто продолжаем без захвата.
      try {
        viewport!.setPointerCapture(event.pointerId);
      } catch {
        /* указатель уже неактивен */
      }
    }

    viewport.addEventListener('pointermove', (event) => {
      const prev = pointers.get(event.pointerId);
      if (!prev) return;
      const next = { x: event.clientX, y: event.clientY };
      pointers.set(event.pointerId, next);

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchDist > 0 && dist > 0) {
          zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, dist / pinchDist);
        }
        pinchDist = dist;
        return;
      }

      if (!dragging) {
        if (!origin) return;
        const moved = Math.hypot(next.x - origin.x, next.y - origin.y);
        if (moved < DRAG_THRESHOLD_PX) return;
        startDragging(event);
      }

      const from = toUser(prev.x, prev.y);
      const to = toUser(next.x, next.y);
      view.x += to.x - from.x;
      view.y += to.y - from.y;
      applyView();
    });

    function endPointer(event: PointerEvent) {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinchDist = 0;
      if (pointers.size === 0) origin = null;
      if (viewport!.hasPointerCapture(event.pointerId)) {
        viewport!.releasePointerCapture(event.pointerId);
      }
    }
    viewport.addEventListener('pointerup', endPointer);
    viewport.addEventListener('pointercancel', endPointer);

    // Перетаскивание не должно срабатывать как переход по ссылке узла.
    // Флаг гасится здесь же: click приходит один раз, следующий pointerdown
    // всё равно начнёт отсчёт заново.
    viewport.addEventListener(
      'click',
      (event) => {
        if (!dragging) return;
        event.preventDefault();
        event.stopPropagation();
        dragging = false;
      },
      true,
    );

    applyView();
  }
</script>

<style>
  .mm {
