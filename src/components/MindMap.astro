  .mm-node[data-kind='l1'] text {
    font-size: 13px;
    font-weight: 600;
  }

  .mm-node[data-kind='leaf'] rect {
    fill: var(--bc-low);
  }
  .mm-node[data-kind='leaf'] text {
    fill: var(--bc-text);
    font-size: 12px;
  }

  .mm-node[data-kind='subleaf'] rect {
    fill: transparent;
    stroke-dasharray: 3 3;
  }
  .mm-node[data-kind='subleaf'] text {
    font-size: 11px;
    fill: var(--sl-color-gray-2);
  }

  .mm-node a {
    cursor: pointer;
  }
  .mm-node a:hover rect,
  .mm-node a:focus rect {
    filter: brightness(1.06);
  }
  .mm-node a:hover text,
  .mm-node a:focus text {
    text-decoration: underline;
