  /* min-height: 0 — иначе flex-элемент не даёт себя сжать ниже контента. */
  .mm[data-expanded='true'] .mm-viewport {
    flex: 1;
    height: auto;
    min-height: 0;
    /* Страница под оверлеем не прокручивается, поэтому вертикальный свайп
