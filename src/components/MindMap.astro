  .mm-node[data-kind='root'] text {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .mm-node[data-kind='branch'] rect {
    fill: var(--bc);
    stroke: var(--bc);
  }
  .mm-node[data-kind='branch'] text {
    fill: #fff;
    font-size: 15px;
    font-weight: 700;
  }
  .mm-branch-icon path {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mm-node[data-kind='l1'] rect {
    stroke-width: 2;
