    stroke-width: 2.6;
    opacity: 0.7;
  }
  .mm-edge[data-depth='2'] {
    stroke-width: 2;
    opacity: 0.6;
  }

  /* --- Узлы --- */
  .mm-node rect {
    fill: var(--sl-color-bg);
    stroke: var(--bc, var(--sl-color-gray-4));
